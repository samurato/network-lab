# GENERATED by automation/render.py (network/wan.yml, kubernetes/cluster.yml) — kernel devices for {{ node.name }}
# FRR's config refers to these, but zebra can't create them.  Idempotent: runs at container start
# (static/frr/start.sh) and before every `make apply` (roles/frr_router).
set -eu
# containerlab plugs the links after the container starts: wait for all of them
until [ "$(ls /sys/class/net | grep -c '^eth[1-9]')" -ge "${CLAB_INTFS:-0}" ]; do sleep 1; done
ip link show {{ node.vrf.name }} >/dev/null 2>&1 || ip link add {{ node.vrf.name }} type vrf table {{ node.vrf.table }}
ip link set {{ node.vrf.name }} up
{% for s in node.vrf.subifs %}
ip link show {{ s.name }} >/dev/null 2>&1 || ip link add link {{ s.parent }} name {{ s.name }} type vlan id {{ s.vlan }}
{% endfor %}
{% for i in node.vrf.interfaces %}
ip link set {{ i.name }} master {{ node.vrf.name }} up
{% endfor %}
