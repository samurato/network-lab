! GENERATED by automation/render.py (network/wan.yml, kubernetes/cluster.yml + AVD l3_edge) — config for {{ node.name }}
hostname {{ node.name }}
log syslog informational
!
interface lo
 ip address {{ node.loopback }}/32
exit
!
{% for itf in node.p2p %}
interface {{ itf.name }}
 description to {{ itf.peer }} {{ itf.peer_port }}
 ip address {{ itf.ip }}
exit
!
{% endfor %}
{% for itf in node.vrf.interfaces %}
interface {{ itf.name }}
 description VRF {{ node.vrf.name }} to {{ itf.peer }}
 ip address {{ itf.ip }}
exit
!
{% endfor %}
router bgp {{ node.asn }}
 bgp router-id {{ node.loopback }}
 bgp log-neighbor-changes
 bgp bestpath as-path multipath-relax
 no bgp ebgp-requires-policy
{% for itf in node.p2p %}
 neighbor {{ itf.peer_ip }} remote-as {{ itf.peer_asn }}
 neighbor {{ itf.peer_ip }} description {{ itf.peer }}
{% endfor %}
 !
 address-family ipv4 unicast
  redistribute connected
  maximum-paths 8
 exit-address-family
 ! BMP (RFC 7854) to the lab's collector: every route this router accepts (post-policy) and the best path it
 ! picks (loc-rib), for the underlay here and for VRF {{ node.vrf.name }} through import-vrf-view. No pre-policy:
 ! without an adj-rib-in copy FRR reports it inaccurately (it sent withdraws for routes still present).
 bmp targets lab
  bmp connect {{ bmp_collector }} port 1790 min-retry 1000 max-retry 10000
  bmp monitor ipv4 unicast post-policy
  bmp monitor ipv4 unicast loc-rib
  bmp import-vrf-view {{ node.vrf.name }}
 exit
exit
!
router bgp {{ node.asn }} vrf {{ node.vrf.name }}
 bgp router-id {{ node.loopback }}
 bgp log-neighbor-changes
 bgp bestpath as-path multipath-relax
 no bgp ebgp-requires-policy
{% for p in node.vrf.peers %}
 neighbor {{ p.ip }} remote-as {{ p.asn }}
 neighbor {{ p.ip }} description {{ p.name }}
{% endfor %}
 !
 address-family ipv4 unicast
  redistribute connected
  maximum-paths 8
 exit-address-family
exit
!
