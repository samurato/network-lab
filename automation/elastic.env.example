# Copy to automation/elastic.env (git-ignored, never commit) on the lab host. See docs/elastic.md.
# Empty ELASTIC_API_KEY = telemetry stays in the lab (collector profile `local`).
#
# Elasticsearch endpoint (Elastic Cloud console -> your project -> Endpoints): collector profile `elastic`
ELASTIC_ES_URL=
# Kibana endpoint: Terraform (automation/elastic) only
ELASTIC_KIBANA_URL=
# Managed OTLP endpoint (Observability project / Cloud Hosted): when set, the collector uses `elastic-otlp`
ELASTIC_OTLP_ENDPOINT=
# admin API key: Terraform only, stays on the lab host, never in CI
ELASTIC_TF_API_KEY=
# lab API key (collector, change events, verify): create in Kibana with `automation/elastic role`
ELASTIC_API_KEY=
# chaos-lab: publish runs to chaos-* (create it from `automation/elastic chaos-role`)
ELASTIC_CHAOS_API_KEY=
