! Intended config for {{ node.name }} — rendered by automation/roles/frr_router (network/wan.yml + AVD l3_edge)
hostname {{ node.name }}
log syslog informational
!
interface lo
 ip address {{ node.loopback }}/32
exit
!
{% for itf in node.p2p %}
interface {{ itf.name }}
 description to {{ itf.peer }} {{ itf.peer_port }}
 ip address {{ itf.ip }}
exit
!
{% endfor %}
router bgp {{ node.asn }}
 bgp router-id {{ node.loopback }}
 bgp log-neighbor-changes
 bgp bestpath as-path multipath-relax
 no bgp ebgp-requires-policy
{% for itf in node.p2p %}
 neighbor {{ itf.peer_ip }} remote-as {{ itf.peer_asn }}
 neighbor {{ itf.peer_ip }} description {{ itf.peer }}
{% endfor %}
 !
 address-family ipv4 unicast
  redistribute connected
  maximum-paths 8
 exit-address-family
exit
!
